# Environment variables for Satoshi Dashboard
# Copy this to .env.local and fill in your values

# Application
VITE_APP_NAME=Satoshi Dashboard
VITE_APP_VERSION=1.0.0

# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_TIMEOUT=30000

# External APIs
VITE_COINGECKO_API=https://api.coingecko.com/api/v3
VITE_MEMPOOL_API=https://mempool.space/api
VITE_BITNODES_API=https://bitnodes.io/api/v1

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_EXPORT=true
VITE_BETA_FEATURES=false

# Development
NODE_ENV=development
VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_PORT=5173

# Database (if needed)
DATABASE_URL=postgresql://user:password@localhost:5432/satoshi

# Authentication (if needed)
JWT_SECRET=your_jwt_secret_here
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret

# Third-party Services
SENTRY_DSN=
POSTHOG_API_KEY=
